# Copy to .env and edit:  copy .env.example .env
# NEVER commit .env. Values below are development placeholders only.

# --- ScyllaDB ---
# Verify an available tag at https://hub.docker.com/r/scylladb/scylla/tags and pin it.
SCYLLA_VERSION=6.2
SCYLLA_HOST_PORT=9042
SCYLLA_SMP=1
SCYLLA_MEMORY=750M
SCYLLA_KEYSPACE=psbc
# Dev = 1 (single node). Production needs 3+ nodes and RF=3.
SCYLLA_REPLICATION_FACTOR=1

# --- Backend (used from M2) ---
API_HOST_PORT=8080
APP_ENV=development
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
